# Copy to .env.local for local dev.

# Where the browser sends API calls. Default "/api/v1" goes through the Vite
# dev proxy (see vite.config.ts). Set an absolute URL to hit a remote backend
# directly (that origin must be in the backend's CORS_ALLOW_ORIGINS).
VITE_API_BASE_URL=/api/v1

# Optional: change what the dev proxy forwards /api to.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
