# Copy this file to .env and fill in real values. .env itself is git-ignored.
#
#   cp .env.example .env
#
# Only DB_PASSWORD and JWT_SECRET strictly need a value for a real deployment;
# everything else has a working default (shown here).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST: use "localhost" when running the app directly on your machine.
# With docker compose, the api container reaches Postgres at host "db" - that
# override is set in docker-compose.yml, so you can leave this as localhost.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=health_companion

# --- Database connection pool (SQLAlchemy engine) ---
# Safe defaults for a single API process. Raise pool size for more workers.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Security (JWT)
# ---------------------------------------------------------------------------
# REQUIRED for any non-local deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave blank locally to fall back to an insecure dev default (a warning is logged).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# CORS (comma-separated browser origins; "*" is rejected)
# ---------------------------------------------------------------------------
# Add the deployed frontend origin, e.g. https://app.yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting (per client IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_CHAT=20/minute

# ---------------------------------------------------------------------------
# AI companion (LLM)
# ---------------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY blank to use canned mock replies (fully testable
# without a key). LLM_ENABLED=false forces mock mode even if a key is set.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=1024
LLM_ENABLED=true

# ---------------------------------------------------------------------------
# ML risk engine
# ---------------------------------------------------------------------------
# When false, or app/ml/model.joblib is missing, the transparent rule-based
# heuristic is used instead of a trained model.
ML_ENABLED=true

# ---------------------------------------------------------------------------
# Historical baseline manager
# ---------------------------------------------------------------------------
BASELINE_WINDOW_DAYS=7
BASELINE_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Allow synthetic telemetry via POST /api/v1/telemetry/simulate. Turn OFF in
# a real deployment.
SIMULATOR_MODE=true
# Used only by helper scripts / tests, not the running API.
DEMO_USER_EMAIL=demo@healthcompanion.local
