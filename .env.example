# Copy this file to .env and fill in real values. .env itself is git-ignored.

DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=health_companion

# --- Database connection pool (SQLAlchemy engine) ---
# Safe defaults for a single API process. Raise pool size for more workers.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Security ---
# REQUIRED for any non-local deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave blank locally to fall back to an insecure dev default (a warning is logged).
JWT_SECRET=

# --- AI companion (leave ANTHROPIC_API_KEY blank to use mock replies) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_ENABLED=true

ML_ENABLED=true

SIMULATOR_MODE=true
